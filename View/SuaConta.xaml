<Window x:Class="Projeto_2biPOO.SuaConta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_2biPOO"
        mc:Ignorable="d"
        Title="Sua Conta" Height="1080" Width="1920" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080">
            <Rectangle HorizontalAlignment="Left" Height="1080" VerticalAlignment="Center" Width="639" Fill="#FF9D3535"/>
            <Rectangle HorizontalAlignment="Left" Height="558" VerticalAlignment="Top" Width="1128" RadiusX="10" RadiusY="10" Fill="#FFE5E5E5" Margin="704,266,0,0"/>
            <Button x:Name="btnPagamento" Content="Ir para Pagamento" Click="BtnPagamento_Click" HorizontalAlignment="Left" Margin="1317,925,0,0" VerticalAlignment="Top" Width="450" Height="80" Background="#FF9D3535" Foreground="White" FontSize="40"/>
            <Button Content="&lt;" Click="BtnVoltar_Click" HorizontalAlignment="Left" Margin="1820,0,0,0" VerticalAlignment="Top" Foreground="White" Background="#FF9D3535" Width="100" Height="100" FontSize="42"/>
            <Label x:Name="lblTituloPedidos" Content="Seus Pedidos:" HorizontalAlignment="Left" Margin="704,166,0,0" VerticalAlignment="Top" FontSize="64" Foreground="#FF9D3535"/>
            <TextBlock HorizontalAlignment="Left" Margin="39,60,0,0" TextWrapping="Wrap" Text="Sua Conta" VerticalAlignment="Top" FontSize="96" Foreground="White"/>

            <DataGrid x:Name="dgItensConta"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      FontSize="22"
                      Width="1128" Height="542" Margin="704,274,88,264">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding Produto}" Width="*"/>
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="160"/>
                    <DataGridTextColumn Header="Preço Unit." Binding="{Binding PrecoUnitario, StringFormat='R$ {0:F2}'}" Width="180"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='R$ {0:F2}'}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <Rectangle HorizontalAlignment="Center" Height="80" Margin="0,925,0,0" Stroke="Black" VerticalAlignment="Top" Width="450" Fill="#FF9D3535"/>
            <Label x:Name="lblTotal" Content="Total: R$ 0,00" HorizontalAlignment="Center" Margin="0,933,0,0" VerticalAlignment="Top" Foreground="White" FontSize="40"/>
        </Grid>
    </Viewbox>
</Window>