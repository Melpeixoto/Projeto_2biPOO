<Window x:Class="Projeto_2biPOO.Mesas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_2biPOO"
        mc:Ignorable="d"
        Title="Mesas" Height="1080" Width="1920" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080">
            <Rectangle HorizontalAlignment="Left" Height="1080" VerticalAlignment="Center" Width="639" Fill="#FF9D3535"/>
            <Rectangle HorizontalAlignment="Center" Height="558" VerticalAlignment="Center" Width="512" RadiusX="10" RadiusY="10" Fill="#FFE5E5E5"/>
            <Button Content="Todos os Pedidos" Click="BtnTodosPedidos_Click" HorizontalAlignment="Left" Margin="94,762,0,0" VerticalAlignment="Top" Width="450" Height="80" Background="White" Foreground="#FF9D3535" FontSize="40"/>
            <Button Content="Voltar para Opções" Click="BtnVoltarOpcoes_Click" HorizontalAlignment="Left" Margin="94,919,0,0" VerticalAlignment="Top" Width="450" Height="80" Background="White" Foreground="#FF9D3535" FontSize="40"/>
            <Button Content="&lt;" Click="BtnVoltarOpcoes_Click" HorizontalAlignment="Left" Margin="1820,0,0,0" VerticalAlignment="Top" Foreground="White" Background="#FF9D3535" Width="100" Height="100" FontSize="42"/>
            <TextBlock HorizontalAlignment="Left" Margin="39,60,0,0" TextWrapping="Wrap" Text="Mesas" VerticalAlignment="Top" FontSize="96" Foreground="White"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="39,210,0,0" Width="560" Height="260" CornerRadius="12" Background="#FFF8F8F8" Padding="12">
                <Image Source="pack://application:,,,/Imagens/woodpeckers_logo.jpeg" Stretch="Uniform"/>
            </Border>

            <DataGrid x:Name="dgMesas"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      MouseDoubleClick="DgMesas_MouseDoubleClick"
                      FontSize="24"
                      Width="1128" Height="842" Margin="704,146,88,92">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/>
                    <DataGridTextColumn Header="Número da Mesa" Binding="{Binding Numero}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Ocupada" Binding="{Binding Status}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Viewbox>
</Window>