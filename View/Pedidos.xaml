<Window x:Class="Projeto_2biPOO.Pedidos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_2biPOO"
        mc:Ignorable="d"
        Title="Pedidos" Height="1080" Width="1920" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="131*"/>
                <RowDefinition Height="139*"/>
            </Grid.RowDefinitions>
            <Rectangle HorizontalAlignment="Left" Height="1080" VerticalAlignment="Top" Width="639" Fill="#FF9D3535" Grid.RowSpan="2"/>
            <Button Content="&lt;" Click="BtnVoltar_Click" HorizontalAlignment="Left" Margin="1820,0,0,0" VerticalAlignment="Top" Foreground="White" Background="#FF9D3535" Width="100" Height="100" FontSize="42"/>
            <TextBlock HorizontalAlignment="Left" Margin="39,60,0,0" TextWrapping="Wrap" Text="Pedidos" VerticalAlignment="Top" FontSize="96" Foreground="White"/>

            <DataGrid x:Name="dgPedidos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      MouseDoubleClick="DgPedidos_MouseDoubleClick"
                      FontSize="22"
                      Grid.RowSpan="2" Width="1128" Height="842" Margin="715,170,77,68">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                    <DataGridTextColumn Header="Mesa" Binding="{Binding Mesa}" Width="140"/>
                    <DataGridTextColumn Header="Data e Hora" Binding="{Binding DataHora, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="260"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotal, StringFormat='R$ {0:F2}'}" Width="200"/>
                    <DataGridTextColumn Header="Desconto" Binding="{Binding Desconto, StringFormat='R$ {0:F2}'}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <Label Content="Todos os Pedidos:" HorizontalAlignment="Left" Margin="715,50,0,0" VerticalAlignment="Top" FontSize="64" Foreground="#FF9D3535"/>
        </Grid>
    </Viewbox>
</Window>