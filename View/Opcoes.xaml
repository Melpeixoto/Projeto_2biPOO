<Window x:Class="Projeto_2biPOO.Opcoes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_2biPOO"
        mc:Ignorable="d"
        Title="Opções" Height="1080" Width="1920" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080">
            <Rectangle HorizontalAlignment="Left" Height="1080" VerticalAlignment="Center" Width="639" Fill="#FF9D3535"/>
            <Button Content="Adicionar Produto" Click="BtnAdicionarProduto_Click" HorizontalAlignment="Left" Margin="774,448,0,0" VerticalAlignment="Top" Width="1050" Height="150" Background="#FF9D3535" Foreground="White" FontSize="40"/>
            <Button Content="Mesas" Click="BtnMesas_Click" HorizontalAlignment="Left" Margin="774,214,0,0" VerticalAlignment="Top" Width="1050" Height="150" Background="#FF9D3535" Foreground="White" FontSize="40"/>
            <TextBlock HorizontalAlignment="Left" Margin="39,60,0,0" TextWrapping="Wrap" Text="Opções" VerticalAlignment="Top" FontSize="96" Foreground="White"/>
            <Label Content="Preencha o espaço a seguir e  clique no botão para&#xD;&#xA;adicionar uma nova mesa" HorizontalAlignment="Left" Margin="774,664,0,0" VerticalAlignment="Top" FontSize="40" Width="1050" Height="118" Foreground="#FF9D3535"/>
            <Label Content="Número da mesa:" HorizontalAlignment="Left" Margin="774,835,0,0" VerticalAlignment="Top" FontSize="40" Foreground="#FF9D3535"/>
            <TextBox x:Name="txtNumeroMesa" HorizontalAlignment="Left" Margin="1131,835,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="280" FontSize="40" Height="66"/>
            <Button Content="Adicionar Mesa" Click="BtnAdicionarMesa_Click" HorizontalAlignment="Left" Margin="1474,835,0,0" VerticalAlignment="Top" Width="350" Height="66" Background="#FF9D3535" Foreground="White" FontSize="40"/>
        </Grid>
    </Viewbox>
</Window>