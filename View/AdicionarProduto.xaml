<Window x:Class="Projeto_2biPOO.AdicionarProduto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_2biPOO"
        mc:Ignorable="d"
        Title="Adicionar Produto" Height="1080" Width="1920" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Rectangle HorizontalAlignment="Left" Height="1080" VerticalAlignment="Center" Width="639" Fill="#FF9D3535"/>
            <Button Content="Cancelar" Click="BtnVoltar_Click" HorizontalAlignment="Left" Margin="766,940,0,0" VerticalAlignment="Top" Width="450" Height="80" Background="#FF9D3535" Foreground="White" FontSize="40"/>
            <Button Content="Adicionar Produto" Click="BtnSalvarProduto_Click" HorizontalAlignment="Left" Margin="1317,940,0,0" VerticalAlignment="Top" Width="450" Height="80" Background="#FF9D3535" Foreground="White" FontSize="40"/>
            <Button Content="&lt;" Click="BtnVoltar_Click" HorizontalAlignment="Left" Margin="1820,0,0,0" VerticalAlignment="Top" Foreground="White" Background="#FF9D3535" Width="100" Height="100" FontSize="42"/>
            <Label Content="Nome:" HorizontalAlignment="Left" Margin="713,166,0,0" VerticalAlignment="Top" FontSize="48" Foreground="#FF9D3535"/>
            <Label Content="Descrição:" HorizontalAlignment="Left" Margin="713,330,0,0" VerticalAlignment="Top" FontSize="48" Foreground="#FF9D3535"/>
            <TextBlock HorizontalAlignment="Left" Margin="39,60,0,0" TextWrapping="Wrap" Text="Adicionar Produto" VerticalAlignment="Top" FontSize="96" Foreground="White" Width="556"/>
            <TextBlock HorizontalAlignment="Left" Margin="991,60,0,0" TextWrapping="Wrap" Text="Novo Produto" VerticalAlignment="Top" FontSize="64" Foreground="#FF9D3535"/>
            <Label Content="Preço:" HorizontalAlignment="Left" Margin="713,710,0,0" VerticalAlignment="Top" FontSize="48" Foreground="#FF9D3535"/>
            <Label Content="Categoria:" HorizontalAlignment="Left" Margin="1461,710,0,0" VerticalAlignment="Top" FontSize="48" Foreground="#FF9D3535"/>
            <TextBox x:Name="txtNome" FontSize="28" HorizontalAlignment="Left" Margin="704,240,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="1135" Height="65"/>
            <TextBox x:Name="txtDescricao" FontSize="28" HorizontalAlignment="Left" Margin="704,409,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="1135" Height="65"/>
            <TextBox x:Name="txtPreco" FontSize="28" HorizontalAlignment="Left" Margin="704,788,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="256" Height="66"/>
            <ComboBox x:Name="cmbCategoria" SelectionChanged="CmbCategoria_SelectionChanged" FontSize="28" HorizontalAlignment="Left" Margin="1461,788,0,0" VerticalAlignment="Top" Width="409" Height="65" BorderBrush="White">
                <ComboBox.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </ComboBox.Background>
                <ComboBoxItem Content="Prato" IsSelected="True"/>
                <ComboBoxItem Content="Bebida"/>
            </ComboBox>
            <Label Content="Igredientes:" HorizontalAlignment="Left" Margin="713,0,0,0" VerticalAlignment="Center" FontSize="48" Foreground="#FF9D3535"/>
            <TextBox x:Name="txtIngredientes" FontSize="28" HorizontalAlignment="Left" Margin="704,582,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="1135" Height="65"/>
            <TextBox x:Name="txtTempo" FontSize="28" HorizontalAlignment="Left" Margin="1212,787,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="222" Height="66"/>
            <TextBox x:Name="txtTamanho" FontSize="28" HorizontalAlignment="Left" Margin="991,787,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Height="66"/>
            <Label Content="Tamanho:" HorizontalAlignment="Left" Margin="978,708,0,0" VerticalAlignment="Top" FontSize="48" Foreground="#FF9D3535"/>
            <Label Content="Tempo:" HorizontalAlignment="Left" Margin="1217,708,0,0" VerticalAlignment="Top" FontSize="48" Foreground="#FF9D3535"/>
            <CheckBox x:Name="chkGelada" Content="Gelada" HorizontalAlignment="Left" Margin="713,664,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" Checked="CheckBox_Checked" FontSize="14" IsChecked="False" IsEnabled="False" Foreground="#FF9D3535">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="2.3" ScaleY="2.3"/>
                </CheckBox.LayoutTransform>
            </CheckBox>
            <Button x:Name="btnEscolherImagem" Content="Escolher Imagem" Click="BtnEscolherImagem_Click" HorizontalAlignment="Left" Margin="704,870,0,0" VerticalAlignment="Top" Width="320" Height="50" Background="#FF9D3535" Foreground="White" FontSize="24"/>
            <TextBlock x:Name="txtCaminhoImagem" Text="Nenhuma imagem selecionada (usará padrão)" HorizontalAlignment="Left" Margin="1040,878,0,0" VerticalAlignment="Top" FontSize="24" Foreground="#FF9D3535"/>
        </Grid>
    </Viewbox>
</Window>